{
  "kind": "collectionType",
  "collectionName": "properties",
  "info": {
    "singularName": "property",
    "pluralName": "properties",
    "displayName": "Property",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string",
      "maxLength": 120,
      "required": true,
      "minLength": 2
    },
    "prevImage": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images",
        "files"
      ]
    },
    "location": {
      "type": "string",
      "minLength": 2,
      "maxLength": 400,
      "required": true
    },
    "price": {
      "type": "integer",
      "required": true
    },
    "users_permissions_user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "properties"
    },
    "type": {
      "type": "enumeration",
      "enum": [
        "rent",
        "sale"
      ]
    },
    "facility": {
      "type": "component",
      "repeatable": false,
      "component": "property.facility",
      "required": true
    },
    "info": {
      "type": "component",
      "repeatable": false,
      "component": "property.information",
      "required": true
    }
  }
}
